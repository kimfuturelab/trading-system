# Dedicated environment for P006 technical-position collector.
# Do NOT reuse SHEETS_WEBHOOK_URL / INGEST_SECRET from the supply collector.

TECH_POSITION_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
TECH_POSITION_INGEST_SECRET=REPLACE_WITH_DEDICATED_SECRET

# LIVE operation
TECH_POSITION_POLL_SECONDS=60
TECH_POSITION_PREP_TIME=08:50
TECH_POSITION_LIVE_START=09:00
TECH_POSITION_SESSION_CONFIRM_UNTIL=09:20
TECH_POSITION_LIVE_END=15:30
TECH_POSITION_FINAL_TIME=15:35

# Optional override. Default is ~/technical-position.env
# TECH_POSITION_ENV_FILE=/home/eogus1215/technical-position.env
