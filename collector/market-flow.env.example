# 3.5 market-flow 전용 설정
# APP_KEY/APP_SECRET/KIWOOM_MODE는 기존 ~/api-read-v2.env에서 읽습니다.
# 이 파일에는 3.5 전용 Webhook과 수집 설정만 둡니다.

WEBHOOK_URL=
WEBHOOK_SECRET=

POLL_SECONDS=300
COLLECT_START_HHMM=0855
COLLECT_END_HHMM=1535

# ka10032 trde_prica 실응답은 백만원 단위로 보이며 /100 시 억원.
# HTS 한 종목 대조 후 최종 확정할 것.
TRADING_VALUE_DIVISOR=100
