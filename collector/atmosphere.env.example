# ATMOSPHERE V1
# Reuses existing Kiwoom + Sheets webhook credentials when present.
# No real secrets in Git.

# Optional overrides. If blank, collector falls back to SHEETS_WEBHOOK_URL / INGEST_SECRET.
ATMOSPHERE_WEBHOOK_URL=
ATMOSPHERE_INGEST_SECRET=

ATMOSPHERE_POLL_SECONDS=20
ATMOSPHERE_LOCK_TIME=08:50
ATMOSPHERE_OPEN_TIME=09:00
ATMOSPHERE_CHECKPOINT_TIME=09:30
ATMOSPHERE_CLOSE_TIME=15:35

ATMOSPHERE_SKHY_EXCHANGE=ND
ATMOSPHERE_SKHY_CODE=SKHY
ATMOSPHERE_HYNIX_CODE=000660
