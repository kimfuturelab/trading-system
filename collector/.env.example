# Kiwoom REST API credentials - NEVER commit real values
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_BASE_URL=https://api.kiwoom.com

# Google Apps Script Web App endpoint
SHEETS_WEBHOOK_URL=
INGEST_SECRET=

# Collection settings
MARKET_TYPE=000
EXCHANGE_TYPE=3
EXCLUDE_MANAGED=1
POLL_SECONDS=300

# Cloud/systemd loop collection window in KST.
# A one-shot run (`python kiwoom_collector.py`) ignores this window for manual testing.
COLLECT_START_HHMM=0855
COLLECT_END_HHMM=1535

# ka10032 trde_prica unit conversion.
# Initial assumption: raw value is KRW million, therefore divide by 100 to convert to 100M KRW (억원).
# MUST be verified against a live sample before production use.
TRADING_VALUE_DIVISOR=100
