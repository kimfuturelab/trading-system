# V0 자동매매 실행 설정
# 실제 값은 서버의 ~/trading-execution.env 등에 저장하고 GitHub에 올리지 않습니다.

# OFF | PAPER | LIVE_SMALL | LIVE
AUTO_MODE=OFF

# ON이면 무조건 신규 주문 차단
KILL_SWITCH=ON

# 실주문을 허용하려면 YES로 명시해야 함
ALLOW_LIVE_ORDERS=NO

# LIVE_SMALL/LIVE에서는 오늘 KST 날짜(YYYY-MM-DD)와 정확히 일치해야 함
DAILY_ARM_DATE=

# 실제 자동매매 전용 계좌번호. GitHub에는 비워 둠.
ALLOWED_ACCOUNT=

# 쉼표 구분 6자리 종목코드. 비어 있으면 주문 차단.
ALLOWED_SYMBOLS=

# V0 기본 1주 제한
MAX_ORDER_QTY=1

# SQLite 상태 파일
STATE_DB=~/.trading-execution-v0.sqlite3

# 기존 공통 인증 환경파일
AUTH_ENV=~/api-read-v2.env
